# Which site this deployment renders: group | surf | skate | snow
# (one Launch project per site, same repo, different env vars)
SITE=group

# Option A — one Launch project = one stack: set the generic variables.
CONTENTSTACK_API_KEY=
CONTENTSTACK_DELIVERY_TOKEN=
CONTENTSTACK_PREVIEW_TOKEN=
CONTENTSTACK_ENVIRONMENT=development
CONTENTSTACK_REGION=us

# Option B — local dev of all four sites: per-site variables, picked by SITE.
# VAK_GROUP_API_KEY=   VAK_GROUP_DELIVERY_TOKEN=   VAK_GROUP_PREVIEW_TOKEN=
# VAK_SURF_API_KEY=    VAK_SURF_DELIVERY_TOKEN=    VAK_SURF_PREVIEW_TOKEN=
# VAK_SKATE_API_KEY=   VAK_SKATE_DELIVERY_TOKEN=   VAK_SKATE_PREVIEW_TOKEN=
# VAK_SNOW_API_KEY=    VAK_SNOW_DELIVERY_TOKEN=    VAK_SNOW_PREVIEW_TOKEN=

# Personalize project per site (optional): VAK_GROUP_PERSONALIZE_PROJECT_UID=

# Public URLs of the four sites (cross-site links in header/footer).
NEXT_PUBLIC_GROUP_URL=http://localhost:3000
NEXT_PUBLIC_SURF_URL=http://localhost:3001
NEXT_PUBLIC_SKATE_URL=http://localhost:3002
NEXT_PUBLIC_SNOW_URL=http://localhost:3003
